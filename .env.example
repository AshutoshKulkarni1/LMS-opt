# ============================================================
# LMS / Test Platform — Environment Configuration Template
# Copy this file to .env and fill in real production values.
#   cp .env.example .env
#
# SECURITY RULES:
# - .env is GITIGNORED — never commit real credentials.
# - In production deployment (Docker, VPS, Render, Cloud),
#   set these as environment variables in your deployment platform.
# ============================================================

# Application Environment: 'production' or 'local'
APP_ENV=production
APP_DEBUG=false

# Database Configuration (DB_ENV: 'production' or 'local')
DB_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=test_platform
DB_USER=test_platform_user
DB_PASS=secure_database_password_here

# Python Analytics API URL
PYTHON_API_URL=http://127.0.0.1:5000

# Email Delivery Configuration (Gmail SMTP)
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Test Platform

# Mail Development Mode: false in production (sends real email)
MAIL_DEV_MODE=false
