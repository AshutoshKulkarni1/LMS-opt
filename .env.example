# ============================================================
# LMS / Test Platform — Environment Configuration Template
# Copy this file to .env and fill in real production values:
#   cp .env.example .env
#
# SECURITY RULES:
# - .env is GITIGNORED — never commit real credentials.
# - In Docker / Production, pass these as environment variables
#   or store them in your secure vault.
# ============================================================

# ─── Application Mode ────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

# ─── Web Server / Host Port ──────────────────────────────────
# The host port on which Docker will expose the web application.
WEB_PORT=8085

# ─── URL Routing ─────────────────────────────────────────────
# BASE_URL: empty string ('') when serving from domain root or Docker.
# ASSETS_URL: '/assets' when serving from domain root or Docker.
BASE_URL=
ASSETS_URL=/assets

# ─── Database Configuration ──────────────────────────────────
# Under Docker Compose:
#   DB_HOST=mariadb
#   DB_PORT=3306
# Under local development:
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
DB_ENV=production
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=test_platform
DB_USER=lms_user
DB_PASS=secure_database_password_here
DB_ROOT_PASSWORD=secure_root_password_here

# ─── Python Analytics API Microservice ───────────────────────
# Under Docker Compose:
#   PYTHON_API_URL=http://flask:5000
# Under local development:
#   PYTHON_API_URL=http://127.0.0.1:5000
PYTHON_API_URL=http://flask:5000

# ─── Ollama AI Integration (Optional) ────────────────────────
# URL to access local or remote Ollama instance.
# When running Ollama on host machine from Docker: http://host.docker.internal:11434
# When running Ollama locally without Docker: http://127.0.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-nothink

# ─── Email Delivery Configuration (Gmail SMTP) ───────────────
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Test Platform

# Mail Development Mode: false in production (sends real email)
MAIL_DEV_MODE=false
